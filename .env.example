PORT=3000
BASE_URL=http://localhost:3000
# Operator access: long random string. Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Anthropic key for generating replies (without it the app runs in demo mode)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Stripe (https://dashboard.stripe.com): secret key, recurring Price id, webhook signing secret
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
